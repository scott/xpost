# xpost server environment: key names and comments only.
# deploy/bootstrap.sh copies this file to /etc/xpost/env (mode 600, root)
# on the first run and fills the three lines under "Set by bootstrap".
# Later runs only add keys that are missing; they never change a value you
# set. Edit /etc/xpost/env, then: systemctl restart xpost
#
# Anything commented out is off or uses its default.

# --- Set by bootstrap (keep them) ---
# Public origin, https://<your domain>.
XPOST_BASE_URL=
# SQLite database path.
XPOST_DB=
# Master key file (bootstrap generates it once; losing it orphans stored X tokens).
XPOST_KEY_FILE=
# Or the key itself instead of a file (XPOST_KEY wins when both are set).
# XPOST_KEY=

# --- X connect (Settings > X accounts) ---
# Your X developer app's OAuth 2.0 client id, and the client secret in a
# root-only file (preferred) or inline.
# XPOST_X_CLIENT_ID=
# XPOST_X_CLIENT_SECRET_FILE=/etc/xpost/x_client_secret
# XPOST_X_CLIENT_SECRET=
# Endpoint overrides; leave unset for the real X endpoints. The local fake
# X (cmd/xpost-fakex) prints the values to use.
# XPOST_X_AUTHORIZE_URL=
# XPOST_X_TOKEN_URL=
# XPOST_X_REVOKE_URL=
# XPOST_X_ME_URL=
# XPOST_X_POST_URL=
# XPOST_X_MEDIA_URL=
# XPOST_X_MEDIA_METADATA_URL=
# XPOST_X_WEB_URL=

# --- Posting (off until you turn it on on purpose) ---
# on: approved, due drafts post to X. Needs X connect and the cost rates.
# XPOST_SCHEDULER=
# Per-request cost estimates in USD for the spend meter; unset means
# unverified, and nothing posts.
# XPOST_COST_POST_USD=
# XPOST_COST_LINK_POST_USD=
# XPOST_COST_MEDIA_UPLOAD_USD=
# XPOST_COST_MEDIA_METADATA_USD=

# --- Optional ---
# Listen address (the -addr flag wins; the systemd unit passes one).
# XPOST_ADDR=
# Display zone until the owner picks one in Settings (IANA name).
# XPOST_TZ=
# WebAuthn relying party id and origin; default: from XPOST_BASE_URL.
# XPOST_RP_ID=
# XPOST_RP_ORIGIN=
# Base of an xstats dashboard, for "View in xstats" links.
# XPOST_XSTATS_URL=

# --- Blogs (optional feature, off by default) ---
# 1 turns on blog posts, Settings > Blogs and the blog publisher.
# XPOST_BLOGS_ENABLED=0
# 1 publishes for real through each blog's API or webhook agent (needs XPOST_BLOGS_ENABLED=1).
# XPOST_BLOG_LIVE=0
# 1 turns on the read-only import of a blog's existing posts (needs XPOST_BLOGS_ENABLED=1).
# XPOST_BLOG_IMPORT=
